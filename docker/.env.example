# Bytebot Environment Variables Example
# Copy this file to .env and fill in your values

# ==================== Anthropic API Configuration ====================

# Option 1: Direct Anthropic API (Default)
ANTHROPIC_API_KEY=sk-ant-api03-xxxxx
# ANTHROPIC_BASE_URL is optional, defaults to https://api.anthropic.com

# Option 2: LiteLLM Proxy (Local or Hosted)
# ANTHROPIC_BASE_URL=http://localhost:8000/v1
# ANTHROPIC_API_KEY=sk-your-litellm-key

# Option 3: OpenRouter (Anthropic models via unified API)
# ANTHROPIC_BASE_URL=https://openrouter.ai/api/v1
# ANTHROPIC_API_KEY=sk-or-v1-xxxxx

# Option 4: Custom Proxy / Enterprise Gateway
# ANTHROPIC_BASE_URL=https://your-proxy.company.com/anthropic/v1
# ANTHROPIC_API_KEY=your-internal-key

# Option 5: AWS Bedrock (requires compatible proxy)
# ANTHROPIC_BASE_URL=https://bedrock-runtime.us-east-1.amazonaws.com
# Use AWS credentials instead of ANTHROPIC_API_KEY (needs proxy layer)

# Option 6: Google Vertex AI (requires compatible proxy)
# ANTHROPIC_BASE_URL=https://us-central1-aiplatform.googleapis.com
# Use GCP credentials instead of ANTHROPIC_API_KEY (needs proxy layer)

# ==================== Database Configuration ====================
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/bytebotdb

# ==================== Service URLs (Internal Docker Network) ====================
BYTEBOT_DESKTOP_BASE_URL=http://bytebot-desktop:9990
BYTEBOT_AGENT_BASE_URL=http://bytebot-agent-cc:9991
BYTEBOT_DESKTOP_VNC_URL=http://bytebot-desktop:9990/websockify

# ==================== Optional: Model Override ====================
# Override the default Claude model (default is claude-sonnet-4-5-20250929)
# ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
# ANTHROPIC_MODEL=claude-opus-4-20250514

# ==================== PostgreSQL Configuration ====================
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
POSTGRES_DB=bytebotdb
